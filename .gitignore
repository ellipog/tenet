# plan is a local working document, not committed
plan.md

# vscode. Personal editor config -- launch profiles, workspace settings -- is not
# something a clone should carry, same as the eclipse and idea blocks below.
.vscode/

# eclipse
bin
*.launch
.settings
.metadata
.classpath
.project

# idea
out
*.ipr
*.iws
*.iml
.idea/*
!.idea/scopes

# gradle
build
.gradle

# Build output redirected by hand, which then got committed by mistake.
#
# Nothing in either repo writes or reads this -- it is `gradlew build > build-output.txt` run once and
# added. So ignoring it costs nothing and stops every build dirtying the working tree, which is worse
# than untidy: a tracked file that changes on every build is one you learn to skim past, and it twice
# read as though the build had modified something it had not.
build-output.txt

# other
eclipse
run
runs

# Test-server logs. A headless run writes these, so tracking them dirties the tree on every test --
# the same fault as build-output.txt above, one directory over.
common/logs/

# Python bytecode. `tools/seed_quests.py` belongs to this repository, so running it drops a
# `__pycache__` beside it -- which is not something a clone should carry.
__pycache__/
*.pyc
