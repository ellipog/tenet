{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "icon": "assets/tenet/icon.png",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://ellipog.dev",
        "sources": "https://github.com/ellipog/tenet",
        "issues": "https://github.com/ellipog/tenet/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.wiki": "https://ellipog.dev/docs/tenet/",
                "modmenu.discord": "https://discord.gg/nA6pm9JHd6"
            }
        }
    },
    "license": "${license}",
    "environment": "*",
    "mixins": [
        "tenet.mixins.json"
    ],
    "entrypoints": {
        "main": [
            "dev.ellipog.tenet.fabric.TenetFabric"
        ],
        "client": [
            "dev.ellipog.tenet.fabric.TenetFabricClient"
        ],
        "jei_mod_plugin": [
            "dev.ellipog.tenet.client.viewer.jei.TenetJeiPlugin"
        ],
        "rei_client": [
            "dev.ellipog.tenet.client.viewer.rei.TenetReiPlugin"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": ">=${fabric_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "armature": ">=${armature_version}"
    },
    "suggests": {
        "jei": "*",
        "roughlyenoughitems": "*"
    }
}
